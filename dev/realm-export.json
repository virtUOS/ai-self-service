{
  "realm": "virtuos",
  "enabled": true,
  "clients": [
    {
      "clientId": "ai-self-service",
      "name": "AI API Key Portal (local dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/callback"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*",
        "backchannel.logout.url": "http://host.docker.internal:8080/backchannel-logout",
        "backchannel.logout.session.required": "true"
      }
    }
  ],
  "users": [
    {
      "username": "student",
      "enabled": true,
      "emailVerified": true,
      "email": "student@uni-osnabrueck.de",
      "firstName": "Test",
      "lastName": "Student",
      "credentials": [
        {
          "type": "password",
          "value": "student",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ]
}