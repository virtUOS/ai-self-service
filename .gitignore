# Environment files — contain the LiteLLM master key and OIDC client secret
.env
.env.local
.env.*.local

# SQLite databases — contain users' plaintext LiteLLM API keys
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build output
/keyosk
/server

# OS / editor cruft
.DS_Store

# Browser-automation output. Playwright writes screenshots and traces into the
# working directory when it is driven from here; they are throwaway captures.
.playwright-mcp/
*.png
# The brand images and the documentation's screenshots are part of the project.
!/web/static/apple-touch-icon.png
!/docs/brand/*.png
!/docs/content/images/screenshots/*.png

# Local Claude Code settings. Per-developer, not shared.
.claude/

# Specs and plans written by AI planning tools during development. Local
# working files, not documentation.
/docs/superpowers/

# The website: build output, Zensical's cache, the virtualenv, and the files
# that the Makefile copies in from web/static and docs/brand.
/docs/site/
/docs/.cache/
/docs/.venv/
/docs/content/assets/
