# LiteLLM
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_MASTER_KEY=sk-...

# OIDC
OIDC_ISSUER_URL=https://oidc-provider.example.com
OIDC_CLIENT_ID=ai-self-service
OIDC_CLIENT_SECRET=...
OIDC_REDIRECT_URL=http://localhost:8080/callback

# App
FRONTEND_URL=http://localhost:8080
# Admins: an OIDC subject (preferred — durable) or an email address (works,
# but the IdP can reassign an address to someone else). The admin panel shows
# each user's subject, click to copy. ADMIN_EMAILS is still read for
# compatibility.
ADMIN_IDS=admin@example.com

# An IdP role that grants the admin panel, which supersedes the list above.
# Preferred: membership is then managed in the IdP rather than here, and no
# redeploy is needed when someone joins or leaves. Needs a mapper that puts
# realm roles in the ID token — Keycloak sends them only in the access token by
# default. A realm that emits no roles falls back to ADMIN_IDS.
# ADMIN_ROLE=ai-self-service-admin

# Database (SQLite; the file is created on first run)
DB_PATH=./data.db

# Server
LISTEN_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
SESSION_DURATION=24h
KEY_DURATION_DAYS=90
