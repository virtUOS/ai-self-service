# LiteLLM
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_MASTER_KEY=sk-...

# OIDC
OIDC_ISSUER_URL=https://oidc-provider.example.com
OIDC_CLIENT_ID=ai-self-service
OIDC_CLIENT_SECRET=...
OIDC_REDIRECT_URL=http://localhost:8080/callback

# App
FRONTEND_URL=http://localhost:8080
ADMIN_EMAILS=admin@example.com

# Database (sqlite default, or postgres)
DB_TYPE=sqlite
DB_PATH=./data.db
# DB_TYPE=postgres
# DB_DSN=postgres://user:pass@localhost/ai_self_service?sslmode=disable

# Server
LISTEN_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
SESSION_DURATION=24h
KEY_DURATION_DAYS=90
