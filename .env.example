# LiteLLM
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_MASTER_KEY=sk-...

# OIDC — preset for the local mock, so nothing here needs changing for
# development:
#   docker compose -f dev/docker-compose.yml --profile mock up -d
# For the dev Keycloak use http://localhost:8081/realms/virtuos; in production
# use your IdP's issuer and the client registered there. See dev/README.md.
OIDC_ISSUER_URL=http://localhost:8081
OIDC_CLIENT_ID=ai-self-service
OIDC_CLIENT_SECRET=local-dev-secret
OIDC_REDIRECT_URL=http://localhost:8080/callback

# App
FRONTEND_URL=http://localhost:8080
# Admins: an OIDC subject (preferred — durable) or an email address (works,
# but the IdP can reassign an address to someone else). The admin panel shows
# each user's subject, click to copy. ADMIN_EMAILS is still read for
# compatibility. admin@example.com is the `admin` user of both dev providers.
ADMIN_IDS=admin@example.com

# An IdP role that grants the admin panel, which supersedes the list above.
# Preferred: membership is then managed in the IdP rather than here, and no
# redeploy is needed when someone joins or leaves. Needs a mapper that puts
# realm roles in the ID token — Keycloak sends them only in the access token by
# default. A realm that emits no roles falls back to ADMIN_IDS.
# ADMIN_ROLE=ai-self-service-admin

# Unit that quota amounts are shown in: the currency LiteLLM prices models
# in, or a word such as "credits" when the prices are nominal.
# BUDGET_UNIT=$

# How many days back the usage chart and per-model table reach. The
# gateway's spend-log retention must cover this, or users see less history
# than the page offers.
# USAGE_HISTORY_DAYS=30

# Set on a portal being retired: the dashboard sends users to this address
# and no longer creates or extends keys here. Existing keys expire on their
# own. Useful, for example, to move users from a test system to production.
# SUCCESSOR_URL=https://ai.example.com

# Privacy notice: an HTML fragment per language, shown at /privacy. Without
# either, the portal has no privacy page. A named file that is missing or
# empty stops startup.
# PRIVACY_NOTICE_FILE_DE=./privacy.de.html
# PRIVACY_NOTICE_FILE_EN=./privacy.en.html

# Database (SQLite; the file is created on first run)
DB_PATH=./data.db

# Expiry emails: set SMTP_HOST (host:port) to send them. Without it the
# portal only logs what it would have sent. Username and password only if
# the relay requires authentication.
# SMTP_HOST=smtp.example.com:25
# SMTP_FROM=noreply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Server
LISTEN_ADDR=127.0.0.1:8080
# Reverse proxies whose X-Forwarded-For is believed for the client address in
# the request log; requests from anywhere else are logged by the connecting
# address. Comma-separated CIDRs or IPs. The default trusts loopback and the
# private ranges; narrow it to your proxy, or "none" to trust nobody.
# TRUSTED_PROXIES=127.0.0.1/32
COOKIE_SECURE=false
SESSION_DURATION=24h
KEY_DURATION_DAYS=90

# Log verbosity: debug, info, warn or error.
# LOG_LEVEL=info

# Limit sync: how many limit updates go to the gateway at once, and how often
# failed updates are retried. Admin changes start an update straight away.
# LIMIT_SYNC_WORKERS=1
# LIMIT_SYNC_INTERVAL=5m
