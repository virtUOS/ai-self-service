# Everything up to the server settings is preset for the local development
# stack, so nothing needs changing for development:
#   docker compose -f dev/docker-compose.yml up -d --wait
# See dev/README.md.

# LiteLLM — the dev stack's gateway and its master key. In production, the
# gateway's URL and a key that may manage keys and users.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev

# Only for several Keyosk instances on one gateway: a distinct prefix for each
# of them but at most one, set before Keyosk issues its first key. A person's
# budget is held on a LiteLLM user named after their OIDC subject, so instances
# without distinct prefixes share every budget. Letters, digits, - _ . only.
# LITELLM_USER_ID_PREFIX=testing

# Record people's email addresses on their LiteLLM users, so LiteLLM's user
# search finds them. Only if every address is unique across everything that
# uses the gateway: LiteLLM's SSO login matches users by address.
# LITELLM_USER_EMAIL=true

# OIDC — the dev stack's mock provider. For the dev Keycloak use
# http://localhost:8082/realms/virtuos; in production use your IdP's issuer and
# the client registered there.
OIDC_ISSUER_URL=http://localhost:8081
OIDC_CLIENT_ID=keyosk
OIDC_CLIENT_SECRET=local-dev-secret
OIDC_REDIRECT_URL=http://localhost:8080/callback

# App
FRONTEND_URL=http://localhost:8080

# Admins (https://virtuos.github.io/keyosk/administrators/). With ADMIN_GROUP set, the members of that
# group in the login system are the admins, read from the ID token at every
# login, and the panel cannot change them. The dev stack's `admin` user is in
# this group with both providers.
ADMIN_GROUP=keyosk-admin
# The claim that lists the groups, as a dot path. Most IdPs send `groups`;
# Keycloak realm roles are `realm_access.roles`.
# ADMIN_GROUP_CLAIM=groups
# Further scopes to request at login. Dex, Okta and Authentik send `groups`
# only when the `groups` scope is requested; Keycloak needs none.
# OIDC_EXTRA_SCOPES=groups
#
# Without ADMIN_GROUP, admins are managed on the panel's Admins tab. Mark the
# first one with a command against the database after they have logged in once:
#   sqlite3 "$DB_PATH" "UPDATE users SET is_admin = 1 WHERE oidc_sub = 'admin'"

# Unit that quota amounts are shown in: the currency LiteLLM prices models
# in, or a word such as "credits" when the prices are nominal.
# BUDGET_UNIT=$

# How many days back the usage chart and per-model table reach. The
# gateway's spend-log retention must cover this, or users see less history
# than the page offers.
# USAGE_HISTORY_DAYS=30

# Set on a Keyosk instance being retired: the dashboard sends users to this
# address and no longer creates or extends keys here. Existing keys expire on
# their own. Useful, for example, to move users from a test system to production.
# SUCCESSOR_URL=https://ai.example.com

# Privacy notice: an HTML fragment per language, shown at /privacy. Without
# either, Keyosk has no privacy page. A named file that is missing or
# empty stops startup.
# PRIVACY_NOTICE_FILE_DE=./privacy.de.html
# PRIVACY_NOTICE_FILE_EN=./privacy.en.html

# Database (SQLite; the file is created on first run)
DB_PATH=./data.db

# Expiry emails: set SMTP_HOST (host:port) to send them. Without it
# Keyosk only logs what it would have sent. Username and password only if
# the relay requires authentication. Preset for the dev stack's Mailpit, which
# shows every mail at http://localhost:8025.
SMTP_HOST=localhost:1025
# SMTP_FROM=noreply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Server
LISTEN_ADDR=127.0.0.1:8080
# Reverse proxies whose X-Forwarded-For is believed for the client address in
# the request log; requests from anywhere else are logged by the connecting
# address. Comma-separated CIDRs or IPs. The default trusts loopback and the
# private ranges; narrow it to your proxy, or "none" to trust nobody.
# TRUSTED_PROXIES=127.0.0.1/32
COOKIE_SECURE=false
# Bearer token /metrics requires, e.g. from `openssl rand -hex 32`. Without
# it, anyone who can reach the endpoint can read the metrics.
# METRICS_TOKEN=
SESSION_DURATION=24h
KEY_DURATION_DAYS=90

# Log verbosity: debug, info, warn or error.
# LOG_LEVEL=info

# Limit sync: how many limit updates go to the gateway at once, and how often
# failed updates are retried. Admin changes start an update straight away.
# LIMIT_SYNC_WORKERS=1
# LIMIT_SYNC_INTERVAL=5m

# How long a key the gateway no longer has stays marked as missing before
# Keyosk removes its record. A key that returns in time is unmarked.
# KEY_MISSING_GRACE_PERIOD=24h
